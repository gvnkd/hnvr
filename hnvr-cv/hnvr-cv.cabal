cabal-version: 2.4
name:          hnvr-cv
version:       0.1.0.0
synopsis:
  HNVR computer vision: ONNX runtime, YOLO decode, SORT tracker, rules

license:       BSD-3-Clause
build-type:    Simple

library
  exposed-modules:
    Hnvr.Cv.Analyzer
    Hnvr.Cv.AnalyzerRunner
    Hnvr.Cv.AutoTrack
    Hnvr.Cv.DebugRender
    Hnvr.Cv.Decode
    Hnvr.Cv.OnnxRuntime
    Hnvr.Cv.OnnxRuntime.Internal
    Hnvr.Cv.Preprocess
    Hnvr.Cv.Rules
    Hnvr.Cv.Tracker.Hungarian
    Hnvr.Cv.Tracker.Kalman
    Hnvr.Cv.Tracker.Sort

  build-depends:
    , base         >=4.18 && <5
    , bytestring
    , containers
    , directory
    , ghc-prim
    , hnvr-core
    , JuicyPixels
    , massiv
    , stm
    , text
    , unix
    , vector

  hs-source-dirs:   src
  default-language: Haskell2010

test-suite hnvr-cv-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:
    Hnvr.Cv.AnalyzerSpec
    Hnvr.Cv.DebugRenderSpec
    Hnvr.Cv.DecodeSpec
    Hnvr.Cv.OnnxRuntimeSpec
    Hnvr.Cv.PreprocessSpec
    Hnvr.Cv.TrackerSpec

  build-depends:
    , async
    , base              >=4.18 && <5
    , bytestring
    , containers
    , deepseq
    , directory
    , filepath
    , hnvr-core
    , hnvr-cv
    , JuicyPixels
    , massiv
    , QuickCheck
    , random
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , time
    , vector

  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A64m -I0"
