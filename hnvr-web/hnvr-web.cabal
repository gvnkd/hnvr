cabal-version: 2.4
name:         hnvr-web
version:      0.1.0.0
synopsis:     HNVR leader (IHP web + event writer + MediaMTX sync) and node binaries
license:      BSD-3-Clause
build-type:   Simple

library
    exposed-modules:
        Hnvr.Web
        Hnvr.Web.Config
        Hnvr.Web.FrontController
        -- IHP-generated from Application/Schema.sql.
        -- Regenerate via:
        --   cd hnvr-web && nix run --accept-flake-config \
        --     'github:digitallyinduced/ihp/v1.6.0#schema-compiler'
        -- Note: Statements/* modules are not exposed — they have ambiguous
        -- 'id' imports when multiple tables share the field name. IHP's
        -- query builder imports them via Generated.ActualTypes which has
        -- the same problem; we hand-write our queries instead (Slice 4c).
        Generated.ActualTypes
        Generated.ActualTypes.Camera
        Generated.ActualTypes.Host
        Generated.ActualTypes.PrimaryKeys
        Generated.Camera
        Generated.CameraInclude
        Generated.Enums
        Generated.Host
        Generated.HostInclude
        Generated.Types
    build-depends:
        base              >= 4.18 && < 5
      , aeson
      , basic-prelude
      , bytestring
      , data-default
      , deepseq
      , hasql
      , hasql-implicits
      , hasql-mapping
      , hasql-postgresql-types
      , http-types
      , ihp
      , postgresql-simple
      , postgresql-types
      , scientific
      , string-conversions
      , text
      , time
      , unordered-containers
      , uuid
      , wai
      , wai-extra
      , warp
      , hnvr-core
      , hnvr-nats
      , hnvr-storage
      , hnvr-capture
      , hnvr-cv
      , hnvr-ptz
    hs-source-dirs:   src, gen
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings
        OverloadedLabels
        DuplicateRecordFields
        DisambiguateRecordFields
        OverloadedRecordDot
        NoFieldSelectors
        ImplicitParams
        TypeSynonymInstances
        FlexibleInstances
        InstanceSigs
        MultiParamTypeClasses
        TypeFamilies
        DataKinds
        TypeOperators
        UndecidableInstances
        ConstraintKinds
        StandaloneDeriving

-- Leader binary: runs on hnvr-2 only. Carries IHP web + EventWriter +
-- MediaMTXConfigSyncer + AssignmentCoordinator + LeaderLease.
executable hnvr-leader
    main-is:          LeaderMain.hs
    hs-source-dirs:   app
    build-depends:
        base
      , text
      , ihp
      , hnvr-web
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A64m -I0"

-- Worker binary: runs on every host (including the leader host). Carries
-- CaptureSupervisor + AnalyzerSupervisor + PtzSupervisor + HealthReporter.
executable hnvr-node
    main-is:          NodeMain.hs
    hs-source-dirs:   app
    build-depends:
        base
      , text
      , stm
      , hnvr-nats
      , hnvr-web
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A64m -I0"
