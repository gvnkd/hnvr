  -- IHP-generated from Application/Schema.sql.
  -- Regenerate via:
  --   cd hnvr-web && nix run --accept-flake-config \
  --     'github:digitallyinduced/ihp/v1.6.0#schema-compiler'
  build-depends:
    , aeson
    , async
    , base                         >=4.18 && <5
    , basic-prelude
    , bytestring
    , containers
    , data-default
    , deepseq
    , directory
    , ekg-core
    , file-embed
    , filepath
    , hasql
    , hasql-implicits
    , hasql-mapping
    , hasql-postgresql-types
    , hnvr-capture
    , hnvr-core
    , hnvr-cv
    , hnvr-nats
    , hnvr-ptz
    , hnvr-storage
    , http-client
    , http-types
    , ihp
    , minio-hs
    , postgresql-simple
    , postgresql-simple-migration
    , postgresql-types
    , scientific
    , stm
    , string-conversions
    , text
    , time
    , typed-process
    , unordered-containers
    , uuid
    , wai
    , wai-extra
    , warp

  hs-source-dirs:     src gen
  default-language:   Haskell2010

  -- Autogenerated by Cabal from the package version field; Hnvr.Web
  -- re-exports it as the app version (logged at startup, served on
  -- /status). Must be listed explicitly or the link fails with an
  -- undefined Paths_hnvr_web closure reference.
  autogen-modules:    Paths_hnvr_web
  other-modules:      Paths_hnvr_web
  default-extensions:
    BlockArguments
    ConstraintKinds
    DataKinds
    DeriveDataTypeable
    DisambiguateRecordFields
    DuplicateRecordFields
    FlexibleContexts
    FlexibleInstances
    ImplicitParams
    InstanceSigs
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TypeApplications
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    UndecidableInstances

-- Leader binary: runs on hnvr-2 only. Carries IHP web + EventWriter +
-- MediaMTXConfigSyncer + AssignmentCoordinator + LeaderLease.
executable hnvr-leader
  main-is:          LeaderMain.hs
  hs-source-dirs:   app
  build-depends:
    , base
    , hnvr-core
    , hnvr-web
    , ihp
    , text

  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A16m"

-- Worker binary: runs on every host (including the leader host). Carries
-- CaptureSupervisor + AnalyzerSupervisor + PtzSupervisor + HealthReporter.
executable hnvr-node
  main-is:          NodeMain.hs
  hs-source-dirs:   app
  build-depends:
    , aeson
    , base
    , hnvr-capture
    , hnvr-core
    , hnvr-cv
    , hnvr-nats
    , hnvr-storage
    , hnvr-web
    , stm
    , text

  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A16m"
