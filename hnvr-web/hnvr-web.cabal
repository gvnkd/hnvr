cabal-version: 2.4
name:         hnvr-web
version:      0.1.0.0
synopsis:     HNVR leader (IHP web + event writer + MediaMTX sync) and node binaries
license:      BSD-3-Clause
build-type:   Simple

library
    exposed-modules:
        Hnvr.Web
        Hnvr.Web.Config
        Hnvr.Web.EventWriter
        Hnvr.Web.HealthCache
        Hnvr.Web.AssignmentCoordinator
        Hnvr.Web.MediaMTXConfigSyncer
        Hnvr.Web.WhepProxy
        Hnvr.Web.FrontController
        Hnvr.Web.Controller.Cameras
        Hnvr.Web.Controller.Cameras.Probe
        Hnvr.Web.Controller.Archive
        Hnvr.Web.Controller.Live
        Hnvr.Web.Controller.Dashboard
        Hnvr.Web.Controller.Hosts
        Hnvr.Web.Controller.Support.Crypto
        Hnvr.Web.View.Layout
        Hnvr.Web.View.Cameras.Index
        Hnvr.Web.View.Cameras.New
        Hnvr.Web.View.Cameras.Edit
        Hnvr.Web.View.Cameras.Show
        Hnvr.Web.View.Archive.Player
        Hnvr.Web.View.Live.Show
        Hnvr.Web.View.Dashboard.Index
        Hnvr.Web.View.Hosts.Index
        Hnvr.Node.HealthReporter
        Hnvr.Node.ConfigWatcher
        -- IHP-generated from Application/Schema.sql.
        -- Regenerate via:
        --   cd hnvr-web && nix run --accept-flake-config \
        --     'github:digitallyinduced/ihp/v1.6.0#schema-compiler'
        Generated.ActualTypes
        Generated.ActualTypes.Camera
        Generated.ActualTypes.Host
        Generated.ActualTypes.PrimaryKeys
        Generated.ActualTypes.Segment
        Generated.Camera
        Generated.CameraInclude
        Generated.Enums
        Generated.Host
        Generated.HostInclude
        Generated.Segment
        Generated.SegmentInclude
        Generated.Statements
        Generated.Statements.CreateCamera
        Generated.Statements.CreateHost
        Generated.Statements.CreateManyCamera
        Generated.Statements.CreateManyHost
        Generated.Statements.CreateManySegment
        Generated.Statements.CreateSegment
        Generated.Statements.FetchCamera
        Generated.Statements.FetchHost
        Generated.Statements.FetchSegment
        Generated.Statements.RowDecoderCamera
        Generated.Statements.RowDecoderHost
        Generated.Statements.RowDecoderSegment
        Generated.Statements.UpdateCamera
        Generated.Statements.UpdateHost
        Generated.Statements.UpdateSegment
        Generated.Types
    build-depends:
        base              >= 4.18 && < 5
      , aeson
      , async
      , basic-prelude
      , bytestring
      , containers
      , data-default
      , deepseq
      , directory
      , filepath
      , hasql
      , hasql-implicits
      , hasql-mapping
      , hasql-postgresql-types
      , http-client
      , http-types
      , ihp
      , postgresql-simple
      , postgresql-types
      , scientific
      , string-conversions
      , text
      , time
      , typed-process
      , unordered-containers
      , uuid
      , wai
      , wai-extra
      , warp
      , hnvr-core
      , hnvr-nats
      , hnvr-storage
      , hnvr-capture
      , hnvr-cv
      , hnvr-ptz
    hs-source-dirs:   src, gen
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings
        OverloadedLabels
        DuplicateRecordFields
        DisambiguateRecordFields
        OverloadedRecordDot
        NoFieldSelectors
        ImplicitParams
        RecordWildCards
        FlexibleContexts
        LambdaCase
        BlockArguments
        NamedFieldPuns
        TypeApplications
        ScopedTypeVariables
        DeriveDataTypeable
        TypeSynonymInstances
        FlexibleInstances
        InstanceSigs
        MultiParamTypeClasses
        TypeFamilies
        DataKinds
        TypeOperators
        UndecidableInstances
        ConstraintKinds
        StandaloneDeriving

-- Leader binary: runs on hnvr-2 only. Carries IHP web + EventWriter +
-- MediaMTXConfigSyncer + AssignmentCoordinator + LeaderLease.
executable hnvr-leader
    main-is:          LeaderMain.hs
    hs-source-dirs:   app
    build-depends:
        base
      , text
      , ihp
      , hnvr-web
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A64m -I0"

-- Worker binary: runs on every host (including the leader host). Carries
-- CaptureSupervisor + AnalyzerSupervisor + PtzSupervisor + HealthReporter.
executable hnvr-node
    main-is:          NodeMain.hs
    hs-source-dirs:   app
    build-depends:
        base
      , text
      , stm
      , hnvr-nats
      , hnvr-web
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A64m -I0"
