packages:
  ./hnvr-core
  ./hnvr-nats
  ./hnvr-storage
  ./hnvr-capture
  ./hnvr-cv
  ./hnvr-ptz
  ./hnvr-web
  ./vendored/nats-queue
  ./vendored/minio-hs

-- NOTE: minio-hs is vendored under ./vendored/minio-hs with the
-- one-token ListObjectsV2 fix: it sent `continuation_token` (underscore)
-- where S3 requires `continuation-token` (hyphen); MinIO ignored the
-- param, so paginated listings looped page 1 forever (the 2026-08-15
-- leader OOM, RSS 13→47 GB). Unmaintained upstream (bug present on
-- master as of 2026-08). flake.nix overrides via callCabal2nix.

-- NOTE: nats-queue is vendored under ./vendored/nats-queue with the
-- single-line sClose → close fix applied (network >= 3.x rename). Keeping
-- the patched copy in-tree is simpler than fighting cabal's
-- source-repository-package --patch-dir (unreliable on cabal 3.16).
-- flake.nix still uses Hackage + overrideAttrs for nix build.
--
-- cabal build all works for hnvr-core/hnvr-nats/hnvr-storage/hnvr-capture/
-- hnvr-cv/hnvr-ptz. Building hnvr-web via cabal currently fails because
-- IHP's transitive deps need version pins that IHP's nix overlay applies
-- but cabal doesn't see. CI uses `nix build` exclusively for hnvr-web.
-- Use `nix build .#hnvr-web` for the canonical web build.

-- Bleeding-edge: GHC 9.12 needs upper-bound relaxations on stale packages.
-- IHP's nix overlay jailbreaks these for `nix build`; cabal needs the same
-- relaxations mirrored here for `cabal build`. Extend this list as
-- `cabal build` discovers failures.
allow-newer:
  *:base,
  *:bytestring,
  *:containers,
  *:text,
  *:time,
  *:transformers,
  *:template-haskell,
  *:deepseq,
  *:binary,
  *:unix,
  *:directory,
  *:process,
  amazonka-core:bytestring,
  massiv:base,
  nats-queue:base,
  nats-queue:bytestring,
  nats-queue:network,
  nats-queue:text,
  nats-queue:aeson,
  nats-queue:containers,
  nats-queue:dequeue,
  nats-queue:network-uri,
  nats-queue:random,
  cabal-test-quickcheck:base,
  cabal-test-quickcheck:QuickCheck

test-show-details: direct

-- Force versions that compile under GHC 9.12. The default solver picks
-- older transitive deps (e.g. socks-0.5.6) which use pre-MonadFail APIs.
constraints:
  socks >= 0.6.0

package *
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wredundant-constraints

-- onnxruntime C library lives in nixpkgs; cabal FFI wiring lands in Phase 3.
