cabal-version: 2.4
name:          hnvr-nats
version:       0.1.0.0
synopsis:      HNVR NATS bus abstraction (publish/subscribe + JetStream)
license:       BSD-3-Clause
build-type:    Simple

library
  exposed-modules:
    Hnvr.Nats.Bus
    Hnvr.Nats.Subjects

  build-depends:
    , aeson
    , base        >=4.18 && <5
    , bytestring
    , hnvr-core
    , nats-queue
    , stm
    , text

  hs-source-dirs:   src
  default-language: Haskell2010

test-suite hnvr-nats-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:
    Hnvr.Nats.BusSpec
    Hnvr.Nats.SubjectsSpec

  build-depends:
    , aeson
    , base         >=4.18 && <5
    , bytestring
    , hnvr-core
    , hnvr-nats
    , nats-queue
    , tasty
    , tasty-hunit
    , text
    , time
    , uuid

  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
