cabal-version: 2.4
name:         hnvr-nats
version:      0.1.0.0
synopsis:     HNVR NATS bus abstraction (publish/subscribe + JetStream)
license:      BSD-3-Clause
build-type:   Simple

library
    exposed-modules:
        Hnvr.Nats.Bus
        Hnvr.Nats.Subjects
    build-depends:
        base              >= 4.18 && < 5
      , bytestring
      , text
      , hnvr-core
    hs-source-dirs:   src
    default-language: Haskell2010
