cabal-version: 2.4
name:          hnvr-capture
version:       0.1.0.0
synopsis:      HNVR RTSP capture: ffmpeg supervision + fMP4 segmenter
license:       BSD-3-Clause
build-type:    Simple

library
  exposed-modules:
    Hnvr.Capture.Ffmpeg
    Hnvr.Capture.Fmp4
    Hnvr.Capture.FrameSource
    Hnvr.Capture.SpoolDrainer
    Hnvr.Capture.Worker

  build-depends:
    , async
    , base           >=4.18 && <5
    , bytestring
    , cryptonite
    , directory
    , filepath
    , hnvr-core
    , hnvr-nats
    , hnvr-storage
    , memory
    , minio-hs
    , process
    , stm
    , text
    , time
    , typed-process
    , vector

  hs-source-dirs:   src
  default-language: Haskell2010

executable hnvr-record-frames
  main-is:          RecordFrames.hs
  build-depends:
    , base          >=4.18 && <5
    , bytestring
    , cryptonite
    , directory
    , filepath
    , hnvr-capture
    , hnvr-core
    , memory
    , process
    , text
    , time

  hs-source-dirs:   app
  default-language: Haskell2010

executable hnvr-capture-loop
  main-is:          CaptureLoop.hs
  build-depends:
    , base          >=4.18 && <5
    , hnvr-capture
    , hnvr-core
    , hnvr-nats
    , hnvr-storage
    , text
    , uuid

  hs-source-dirs:   app
  default-language: Haskell2010

test-suite hnvr-capture-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:
    Hnvr.Capture.FfmpegSpec
    Hnvr.Capture.Fmp4Spec
    Hnvr.Capture.FrameSourceSpec
    Hnvr.Capture.WorkerSpec

  build-depends:
    , base              >=4.18 && <5
    , bytestring
    , hnvr-capture
    , QuickCheck
    , stm
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , time

  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
