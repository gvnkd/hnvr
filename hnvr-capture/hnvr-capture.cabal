cabal-version: 2.4
name:         hnvr-capture
version:      0.1.0.0
synopsis:     HNVR RTSP capture: ffmpeg supervision + fMP4 segmenter
license:      BSD-3-Clause
build-type:   Simple

library
    exposed-modules:
        Hnvr.Capture.Ffmpeg
        Hnvr.Capture.Fmp4
        Hnvr.Capture.Worker
    build-depends:
        base              >= 4.18 && < 5
      , bytestring
      , text
      , time
      , typed-process
      , hnvr-core
      , hnvr-nats
      , hnvr-storage
    hs-source-dirs:   src
    default-language: Haskell2010

executable hnvr-record-frames
    main-is:          RecordFrames.hs
    build-depends:
        base              >= 4.18 && < 5
      , bytestring
      , cryptonite
      , directory
      , filepath
      , memory
      , process
      , text
      , time
      , hnvr-core
      , hnvr-capture
    hs-source-dirs:   app
    default-language: Haskell2010
