cabal-version: 2.4
name:         hnvr-core
version:      0.1.0.0
synopsis:     HNVR shared core types and utilities
license:      BSD-3-Clause
build-type:   Simple

library
    exposed-modules:
        Hnvr.Core.Id
        Hnvr.Core.Geometry
        Hnvr.Core.Logging
        Hnvr.Core.Prelude
    build-depends:
        base              >= 4.18 && < 5
      , aeson             >= 2.0  && < 2.3
      , bytestring        >= 0.11 && < 0.13
      , text              >= 1.2  && < 2.2
      , time              >= 1.12 && < 1.15
      , uuid              >= 1.3  && < 1.4
    hs-source-dirs:   src
    default-language: Haskell2010
