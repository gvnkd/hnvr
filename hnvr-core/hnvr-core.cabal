cabal-version: 2.4
name:          hnvr-core
version:       0.1.0.0
synopsis:      HNVR shared core types and utilities
license:       BSD-3-Clause
build-type:    Simple

library
  exposed-modules:
    Hnvr.Core.ArchiveBrowser
    Hnvr.Core.Assignment
    Hnvr.Core.AudioProbe
    Hnvr.Core.Authz
    Hnvr.Core.BasePath
    Hnvr.Core.CameraSnapshot
    Hnvr.Core.CameraStatus
    Hnvr.Core.Clip
    Hnvr.Core.Config
    Hnvr.Core.Crypto
    Hnvr.Core.Dvrip
    Hnvr.Core.Event
    Hnvr.Core.Frame
    Hnvr.Core.Geometry
    Hnvr.Core.HostClaim
    Hnvr.Core.Id
    Hnvr.Core.Logging
    Hnvr.Core.MediaMtxLive
    Hnvr.Core.Metrics
    Hnvr.Core.Onvif
    Hnvr.Core.Playlist
    Hnvr.Core.Prelude
    Hnvr.Core.Ptz
    Hnvr.Core.Recording
    Hnvr.Core.Segment
    Hnvr.Core.Time
    Hnvr.Core.Timeline
    Hnvr.Core.Whep

  build-depends:
    , aeson              >=2.0  && <2.3
    , base               >=4.18 && <5
    , base64-bytestring
    , bytestring         >=0.11 && <0.13
    , containers
    , cryptonite
    , directory
    , memory
    , text               >=1.2  && <2.2
    , time               >=1.12 && <1.15
    , uuid               >=1.3  && <1.4
    , vector
    , yaml

  hs-source-dirs:   src
  default-language: Haskell2010

executable hnvr-crypto-test
  main-is:          CryptoTest.hs
  build-depends:
    , base        >=4.18 && <5
    , bytestring
    , hnvr-core
    , text

  hs-source-dirs:   app
  default-language: Haskell2010

test-suite hnvr-core-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:
    Hnvr.Core.ArchiveBrowserSpec
    Hnvr.Core.AssignmentSpec
    Hnvr.Core.AudioProbeSpec
    Hnvr.Core.AuthzSpec
    Hnvr.Core.BasePathSpec
    Hnvr.Core.CameraSnapshotSpec
    Hnvr.Core.CameraStatusSpec
    Hnvr.Core.ClipSpec
    Hnvr.Core.ConfigSpec
    Hnvr.Core.CryptoSpec
    Hnvr.Core.DvripSpec
    Hnvr.Core.EventSpec
    Hnvr.Core.FrameSpec
    Hnvr.Core.GeometrySpec
    Hnvr.Core.HostClaimSpec
    Hnvr.Core.IdSpec
    Hnvr.Core.MediaMtxLiveSpec
    Hnvr.Core.MetricsSpec
    Hnvr.Core.OnvifSpec
    Hnvr.Core.PlaylistSpec
    Hnvr.Core.PtzSpec
    Hnvr.Core.RecordingSpec
    Hnvr.Core.SegmentSpec
    Hnvr.Core.TimelineSpec
    Hnvr.Core.TimeSpec
    Hnvr.Core.WhepSpec

  build-depends:
    , aeson
    , base              >=4.18 && <5
    , bytestring
    , containers
    , hnvr-core
    , QuickCheck
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , time
    , uuid
    , vector

  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
